# Variable names only. WS-C fills these in. Never commit real values.
# Public by design (protected by RLS). Never put a service-role key in this app.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Local integration tests only (npx supabase start). Skipped when unset.
# SUPABASE_TEST_DB_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres

# Search indexing. Leave unset (noindex) until the public launch; then set to true in production.
# NEXT_PUBLIC_INDEXABLE=true
